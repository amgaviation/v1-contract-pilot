# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env
.env
.env*.local

# misc
.DS_Store
*.pem
npm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts.bak

# vercel
.vercel

# transient git worktrees the Agent tool creates for isolated parallel
# subagent work — never project content, and each is a full checkout with
# its own .git, so committing one would vendor a nested repo
/.claude/worktrees/

# receipt-OCR engine assets, copied from node_modules by
# scripts/sync-ocr-assets.mjs on predev/prebuild. ~11 MB of binaries whose
# source of truth is package-lock.json — never committed.
/public/ocr/

# Scratch probes written by review agents against the real modules.
# Never part of the product.
/.qa-probe/

# next-env.d.ts — generated by Next on every `next dev` / `next build`, and
# marked "should not be edited" in its own body. It is untracked rather than
# committed (which Next's docs suggest) because its CONTENT depends on which
# command ran last: `next build` writes
#   import "./.next/types/routes.d.ts";
# and `next dev` writes
#   import "./.next/dev/types/routes.d.ts";
# so it produces a spurious diff on every machine that runs both, and PRs
# carry a one-line change that reverses itself next build.
#
# Safe here because tsconfig.json's `include` already lists BOTH
# .next/types/**/*.ts and .next/dev/types/**/*.ts directly, so the import
# this file contributes is redundant for typechecking — and note it points
# INTO .next/, which is itself ignored, so the committed version referenced a
# path that does not exist in a fresh clone anyway.
#
# The invariant that keeps this safe is checked on every PR without anyone
# remembering to: the CI build job runs `npm ci` then `npm test` (which
# typechecks) BEFORE `npm run build`, so typecheck already runs with no
# .next/ and now no next-env.d.ts. If some future change makes Next's ambient
# types load-bearing for tsc, that job fails immediately rather than quietly.
next-env.d.ts
