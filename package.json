{
  "name": "v1-contract-pilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "tokens:verify": "node scripts/verify-tokens.mjs",
    "tenancy:verify": "node scripts/tenancy-verify.mjs",
    "test": "npm run typecheck && npm run tokens:verify && npm run test:unit",
    "billing:verify": "node scripts/billing-verify.mjs",
    "trip:verify": "node scripts/trip-verify.mjs",
    "customisation:verify": "node scripts/customisation-verify.mjs",
    "connect:verify": "node scripts/connect-verify.mjs",
    "invoice-share-verify": "node scripts/invoice-share-verify.mjs",
    "bank-import:verify": "node --experimental-strip-types scripts/bank-import-verify.mjs",
    "foreflight-import:verify": "node scripts/foreflight-import-verify.mjs",
    "test:unit": "node --test --experimental-strip-types --import ./scripts/lib/ts-extensionless-loader.mjs \"tests/*.test.mjs\"",
    "predev": "node scripts/sync-ocr-assets.mjs",
    "prebuild": "node scripts/sync-ocr-assets.mjs",
    "receipt-ocr:verify": "node scripts/receipt-ocr-verify.mjs",
    "estimates:verify": "node scripts/estimates-verify.mjs",
    "aircraft:verify": "node scripts/aircraft-verify.mjs",
    "payment-reversal:verify": "node scripts/payment-reversal-verify.mjs"
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "next": "^16.2.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "stripe": "^22.4.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "typescript": "^5.7.2"
  }
}
