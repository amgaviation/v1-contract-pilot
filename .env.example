# Supabase — new, dedicated "master" project. NEVER point this at
# amgaviation/amg1's project (vsynqnqlouvphiniqaiy). See docs/PLAN.md §2.
#
# Note the missing NEXT_PUBLIC_ prefix: these names match what's actually
# configured in Vercel. NEXT_SUPABASE_URL and NEXT_SUPABASE_PUBLISHABLE_KEY
# are exposed to the browser bundle via the explicit `env` block in
# next.config.ts (Next's supported way to inline a non-NEXT_PUBLIC_-prefixed
# var), NOT Next's automatic prefix convention. NEXT_SUPABASE_SECRET_KEY
# must never be added to that `env` block — it's read only in
# lib/supabase/service-role.ts, a server-only module.
NEXT_SUPABASE_URL=
NEXT_SUPABASE_PUBLISHABLE_KEY=
NEXT_SUPABASE_SECRET_KEY=

# Platform billing — Stripe subscription (we bill the pilot). Separate
# Stripe product/account from Connect below. See docs/PLAN.md §Architecture.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SOLO=
STRIPE_PRICE_ID_BUSINESS_SEAT=

# Stripe Connect (Standard) — pilot bills their own client. We never see
# the pilot's keys; this is our platform's Connect application config only.
STRIPE_CONNECT_CLIENT_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000
